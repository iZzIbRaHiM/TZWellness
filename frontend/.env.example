# =============================================================================
# TZ Wellness - Supabase Configuration
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development
# 2. For Vercel deployment, add these in:
#    Vercel Dashboard > Project Settings > Environment Variables
#
# IMPORTANT: Never commit .env.local or files with real secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Project Settings > API
#
# Project URL (always safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (NEVER expose to frontend - server-side only!)
# Only use in Server Actions, Route Handlers, or Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# REQUIRED: Site URL
# -----------------------------------------------------------------------------
# Your frontend URL - used for redirects, SEO, and absolute URLs
#
# Development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production (set in Vercel Dashboard):
# NEXT_PUBLIC_SITE_URL=https://tzwellness.com

# -----------------------------------------------------------------------------
# OPTIONAL: Email Service (Resend recommended)
# -----------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
# Used by Supabase Edge Functions for sending emails
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# OPTIONAL: Clinic Information
# -----------------------------------------------------------------------------
# Used in email templates and contact forms
NEXT_PUBLIC_CLINIC_NAME=TZ Wellness
NEXT_PUBLIC_CLINIC_PHONE=+1 (555) 123-4567
NEXT_PUBLIC_CLINIC_EMAIL=info@tzwellness.com

# -----------------------------------------------------------------------------
# OPTIONAL: Analytics
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# OPTIONAL: Error Tracking
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=


# -----------------------------------------------------------------------------
# OPTIONAL: Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable analytics tracking (set to "true" to enable)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# VERCEL ENVIRONMENT VARIABLES CHECKLIST
# =============================================================================
# 
# Required for Production:
# ✅ NEXT_PUBLIC_API_URL     - Your backend API URL (https://...)
# ✅ NEXT_PUBLIC_SITE_URL    - Your frontend URL (https://...)
#
# Optional but Recommended:
# ⬜ NEXT_PUBLIC_GA_ID       - Google Analytics ID
# ⬜ NEXT_PUBLIC_SENTRY_DSN  - Sentry error tracking DSN
# ⬜ NEXT_PUBLIC_ENABLE_ANALYTICS - Set to "true" for production
#
# Automatically Provided by Vercel:
# ✅ VERCEL_URL              - Preview deployment URL
# ✅ VERCEL_ENV              - "production", "preview", or "development"
# ✅ NODE_ENV                - "production" for all deployments
# =============================================================================
