# =============================================================================
# Frontend Environment Variables for TZ Wellness Health
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development
# 2. For Vercel deployment, add these in:
#    Vercel Dashboard > Project Settings > Environment Variables
#
# IMPORTANT: Never commit .env.local or any file with real secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: API Configuration
# -----------------------------------------------------------------------------
# Backend API URL - MUST be set for production
# Do NOT include /api/v1 suffix - it's added automatically by the API client
#
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production (set in Vercel Dashboard):
# NEXT_PUBLIC_API_URL=https://api.tzwellnesshealth.com

# -----------------------------------------------------------------------------
# REQUIRED: Site URL
# -----------------------------------------------------------------------------
# Your frontend URL - used for SEO, Open Graph, and absolute URLs
#
# Development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production (set in Vercel Dashboard):
# NEXT_PUBLIC_SITE_URL=https://tzwellnesshealth.com
# Note: Vercel also provides VERCEL_URL automatically for preview deployments

# -----------------------------------------------------------------------------
# OPTIONAL: Analytics
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
# Get this from: Google Analytics > Admin > Data Streams > your stream
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# OPTIONAL: Error Tracking (Recommended for production)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get this from: Sentry > Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL: Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable analytics tracking (set to "true" to enable)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# VERCEL ENVIRONMENT VARIABLES CHECKLIST
# =============================================================================
# 
# Required for Production:
# ✅ NEXT_PUBLIC_API_URL     - Your backend API URL (https://...)
# ✅ NEXT_PUBLIC_SITE_URL    - Your frontend URL (https://...)
#
# Optional but Recommended:
# ⬜ NEXT_PUBLIC_GA_ID       - Google Analytics ID
# ⬜ NEXT_PUBLIC_SENTRY_DSN  - Sentry error tracking DSN
# ⬜ NEXT_PUBLIC_ENABLE_ANALYTICS - Set to "true" for production
#
# Automatically Provided by Vercel:
# ✅ VERCEL_URL              - Preview deployment URL
# ✅ VERCEL_ENV              - "production", "preview", or "development"
# ✅ NODE_ENV                - "production" for all deployments
# =============================================================================
