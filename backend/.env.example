# =============================================================================
# Django Backend Environment Variables for TZ Wellness Health
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local development
# 2. For production, set these in your hosting platform (Railway, Render, etc.)
#
# IMPORTANT: Never commit .env or any file with real secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Django Settings
# -----------------------------------------------------------------------------
# Generate a new secret key for production: 
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here

# Set to False in production!
DEBUG=True

# Comma-separated list of allowed hosts
# Production example: ALLOWED_HOSTS=api.tzwellnesshealth.com,tzwellnesshealth.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# REQUIRED: Database Configuration
# -----------------------------------------------------------------------------
# For SQLite (development only):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# For PostgreSQL (recommended for production):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tf_wellfare
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# REQUIRED: Redis Configuration
# -----------------------------------------------------------------------------
# Used for Celery task queue and caching
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# REQUIRED: CORS Configuration (CRITICAL FOR VERCEL FRONTEND)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# 
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# Production (include your Vercel domains):
# CORS_ALLOWED_ORIGINS=https://tzwellnesshealth.com,https://tz-wellness-health.vercel.app
#
# For preview deployments, consider using regex patterns in Django settings

# -----------------------------------------------------------------------------
# REQUIRED: Email Configuration
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TZ Wellness Health <noreply@tzwellnesshealth.com>

# -----------------------------------------------------------------------------
# REQUIRED: Clinic Information
# -----------------------------------------------------------------------------
CLINIC_PHONE=+1 (555) 123-4567
CLINIC_EMAIL=contact@tzwellnesshealth.com
CLINIC_ADDRESS=123 Wellness Avenue, Health City, HC 12345

# -----------------------------------------------------------------------------
# OPTIONAL: Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
#
# Before deploying to production, ensure:
#
# ✅ SECRET_KEY is a new, randomly generated value
# ✅ DEBUG=False
# ✅ ALLOWED_HOSTS includes your API domain
# ✅ CORS_ALLOWED_ORIGINS includes your Vercel frontend domain(s)
# ✅ Database is PostgreSQL with proper credentials
# ✅ Redis is properly configured
# ✅ Email credentials are set for notifications
# ✅ SENTRY_DSN is configured for error tracking
#
# =============================================================================

