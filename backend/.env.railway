# Railway Environment Variables Template
# Copy this to Railway Dashboard > Settings > Variables

# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings.railway
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False

# Allowed Hosts (comma-separated, no spaces)
ALLOWED_HOSTS=*.railway.app,*.up.railway.app,your-custom-domain.com

# Database (Auto-configured by Railway PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database
# Don't set manually - Railway sets this automatically

# Redis (Auto-configured by Railway Redis)
# REDIS_URL=redis://host:port
# Don't set manually - Railway sets this automatically

# CORS Configuration (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# Email Configuration (Optional but recommended)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=TF Wellfare <noreply@tfwellfare.com>

# Clinic Information
CLINIC_NAME=TF Wellfare Medical Clinic
CLINIC_PHONE=+1 (555) 123-4567
CLINIC_EMAIL=contact@tfwellfare.com
CLINIC_ADDRESS=123 Wellness Avenue, Health City, HC 12345

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn-here

# Security (Optional - defaults are good)
SECURE_SSL_REDIRECT=True
